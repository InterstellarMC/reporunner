# Copy into your shell or load with your preferred environment manager.
# Base URLs include /v1 when the provider requires it.
SUPERVISOR_BASE_URL=https://your-provider.example/v1
SUPERVISOR_MODEL=your-supervisor-model
SUPERVISOR_API_KEY=
WORKER_BASE_URL=http://127.0.0.1:8001/v1
WORKER_MODEL=your-open-source-model
WORKER_API_KEY=
# Optional per-specialist overrides: WORKER_DEPENDENCY_MODEL,
# WORKER_DEPENDENCY_BASE_URL, WORKER_DEPENDENCY_API_KEY (likewise for other roles).
EXECUTION_BASE_URL=http://127.0.0.1:8002
EXECUTION_SERVICE_TOKEN=replace-with-execution-service-token
SUPERVISOR_SERVICE_TOKEN=replace-with-random-supervisor-service-token
REPORUNNER_DB=reporunner.db

# Integrated local application (does not need the standalone service tokens above):
# REPORUNNER_DATA=/absolute/path/to/run-data
REPORUNNER_PYTHON_IMAGE=python:3.11-slim
REPORUNNER_NODE_IMAGE=node:20-slim
REPORUNNER_GO_IMAGE=golang:1-bookworm
REPORUNNER_RUST_IMAGE=rust:1-slim
REPORUNNER_JAVA_IMAGE=maven:3.9-eclipse-temurin-21
REPORUNNER_DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:8.0
# Up to three transient/invalid-JSON retries, still inside the run time budget.
REPORUNNER_MODEL_TIMEOUT_SECONDS=180

# Repository capacities (MiB), set before server startup.
REPORUNNER_MAX_DOWNLOAD_MB=256
REPORUNNER_MAX_ARCHIVE_MB=1024
REPORUNNER_MAX_SOURCE_MB=768
REPORUNNER_MAX_FILE_MB=256
REPORUNNER_MAX_MEMBERS=50000
REPORUNNER_WORKSPACE_MB=1024
REPORUNNER_MEMORY_MB=2048
REPORUNNER_TMP_MB=192
