{
  "$defs": {
    "Command": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "cwd": {
          "default": ".",
          "title": "Cwd",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "argv"
      ],
      "title": "Command",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Accepted Task Ids",
      "type": "array"
    },
    "commands": {
      "items": {
        "$ref": "#/$defs/Command"
      },
      "maxItems": 8,
      "title": "Commands",
      "type": "array"
    },
    "rationale": {
      "default": "",
      "title": "Rationale",
      "type": "string"
    },
    "human_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Reason"
    }
  },
  "title": "Decision",
  "type": "object"
}
